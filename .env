# ---- LLM ----
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o

# ---- Observability ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=scalable-agentic-system

# ---- Postgres (tool registry + pgvector + RAG store) ----
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/agentic_system

# ---- Redis (session state + cache) ----
REDIS_URL=redis://localhost:6379/0

# ---- Tool Router ----
TOP_K_TOOLS=8
EMBEDDING_MODEL=text-embedding-3-small

# ---- PayPal (example external system) ----
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ---- Security ----
JWT_SECRET=change_me
